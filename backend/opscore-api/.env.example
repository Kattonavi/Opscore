# ─── Backend env vars (Spring Boot) ───────────────────────────────────
# Copy to .env and load via your IDE / dotenv runner. Spring reads them
# automatically when set as real environment variables.

# Active profile: "dev" (default) | "prod"
SPRING_PROFILES_ACTIVE=dev

# HTTP port. Railway injects PORT at runtime; locally we default to 8080.
PORT=8080

# ── Datasource ──
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/opscore_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ── JPA / Hibernate ──
# dev typically uses "update"; prod should use "validate".
SPRING_JPA_DDL_AUTO=update

# ── JWT ──
# Must be 32+ bytes (256 bits). Generate with:
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-please-min-32-bytes-long-1234567890
JWT_EXPIRATION=86400000

# ── CORS ──
# Comma-separated origins. Add your frontend URL(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── HikariCP (prod profile only) ──
DB_POOL_MAX=5
DB_POOL_CONN_TIMEOUT=20000

# ── Seeder (DataSeeder) ──
# Idempotent: creates roles + areas + an admin user if not present.
# Recommended only for the FIRST deploy. Disable afterwards.
OPSCORE_SEED_ENABLED=true
OPSCORE_SEED_ADMIN_EMAIL=admin@opscore.com
# Demo password — change immediately after first login.
OPSCORE_SEED_ADMIN_PASSWORD=abcd1234

# ── Swagger / OpenAPI (optional toggle) ──
# Set both to false to hide /swagger-ui and /v3/api-docs in production.
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_API_DOCS_ENABLED=true
