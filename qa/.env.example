# ─── QA E2E env vars ──────────────────────────────────────────────────
# Copy this file to .env (or export the variables in your shell) before
# running Playwright. NEVER commit a populated .env.
#
# Two URLs are required because the backend and frontend are deployed
# independently:

# Backend (API tests).
E2E_API_URL=http://localhost:8080

# Frontend (UI / browser tests).
E2E_BASE_URL=http://localhost:3000

# ── Admin credentials ────────────────────────────────────────────────
# MUST exist in the target database before the tests run. The defaults
# match the seed created by `backend/opscore-api` `DataSeeder` when
# OPSCORE_SEED_ENABLED=true on the first deploy.
E2E_ADMIN_EMAIL=admin@opscore.com
E2E_ADMIN_PASSWORD=abcd1234

# ── Optional pre-existing per-role users ─────────────────────────────
# If left blank, the specs will bootstrap deterministic users via the
# admin account (e2e-<role>@opscore.local) the first time they run, and
# reuse them afterwards.
# E2E_MANAGER_EMAIL=
# E2E_MANAGER_PASSWORD=
# E2E_SUPERVISOR_EMAIL=
# E2E_SUPERVISOR_PASSWORD=
# E2E_TECHNICIAN_EMAIL=
# E2E_TECHNICIAN_PASSWORD=
# E2E_OPERATOR_EMAIL=
# E2E_OPERATOR_PASSWORD=

# ── Role IDs (must match the `roles` table) ──────────────────────────
E2E_ROLE_ID_ADMIN=1
E2E_ROLE_ID_MANAGER=2
E2E_ROLE_ID_SUPERVISOR=3
E2E_ROLE_ID_TECHNICIAN=4
E2E_ROLE_ID_OPERATOR=5

# ── Legacy aliases ───────────────────────────────────────────────────
# The pre-Fase-4 specs still honour these. They are kept for back-compat
# only; new specs use the E2E_* variables above.
# API_BASE_URL=
# API_ADMIN_EMAIL=
# API_ADMIN_PASSWORD=
