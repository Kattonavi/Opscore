# ─── QA env vars ───────────────────────────────────────────────────────
# Override the defaults baked into tests/test-utils.ts.

# Backend base URL the tests should hit (passed to Playwright via baseURL).
API_BASE_URL=http://localhost:8080

# Admin credentials. Must exist in the target database before running tests.
API_ADMIN_EMAIL=admin@opscore.com
API_ADMIN_PASSWORD=abcd1234

# Role IDs (must match the rows in the `roles` table).
API_ROLE_ID_ADMIN=1
API_ROLE_ID_MANAGER=2
API_ROLE_ID_SUPERVISOR=3
API_ROLE_ID_TECHNICIAN=4
API_ROLE_ID_OPERATOR=5
